{
  "name": "quasi-agent",
  "displayName": "Quasi Agent",
  "description": "Agent chat for Quasi-Gravity.",
  "version": "1.0.0",
  "publisher": "quasi-gravity",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/host/extension.js",
  "activationEvents": [
    "onView:quasi.chat.view",
    "onCommand:quasi.chat.open",
    "onCommand:quasi.chat.newChat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quasi.chat.open",
        "title": "Quasi: Open Chat",
        "category": "Quasi"
      },
      {
        "command": "quasi.chat.newChat",
        "title": "Quasi: New Chat",
        "category": "Quasi"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "quasiChat",
          "title": "Quasi Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "quasiChat": [
        {
          "id": "quasi.chat.view",
          "type": "webview",
          "name": "Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Quasi Chat"
        }
      ]
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:quasi-agent",
    "watch": "gulp watch-extension:quasi-agent",
    "test": "node ../../node_modules/mocha/bin/mocha \"out/test/**/*.test.js\""
  }
}
